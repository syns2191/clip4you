# ── LLM (clip selection) ────────────────────────────────────────────────────
# "groq" = free | "anthropic" = paid
LLM_PROVIDER=groq

# Groq — get key at console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Transcription ────────────────────────────────────────────────────────────
# "groq" = cloud, fast, free (default) | "local" = offline, uses your CPU
TRANSCRIPTION_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local whisper settings (only used when TRANSCRIPTION_PROVIDER=local)
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ── Story mode (visuals) ─────────────────────────────────────────────────────
# Free API key from https://www.pexels.com/api/ (for stock images/videos)
PEXELS_API_KEY=

# ── AI Image Generation (story mode --visuals) ───────────────────────────────
# OpenAI image generation — needed if --visuals openai
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1

# Stable Diffusion local API — needed if --visuals sd
# Point to your automatic1111/ComfyUI/Forge URL
SD_API_URL=http://127.0.0.1:7860

# ── YouTube Upload ────────────────────────────────────────────────────────────
# OAuth client_secret.json path (default: ./client_secret.json)
# Get it from https://console.cloud.google.com/ → YouTube Data API v3 → OAuth 2.0
YOUTUBE_CLIENT_SECRETS=client_secret.json

# ── Output ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output
